# Optional host-facing overrides. Container-internal ports remain fixed.
OUTAGEGYM_BIND_ADDRESS=127.0.0.1
FLOCI_HOST_PORT=4566
FLOCI_UI_HOST_PORT=4500
PROMETHEUS_HOST_PORT=9090
LOKI_HOST_PORT=3100
OTEL_HEALTH_HOST_PORT=13133
GRAFANA_HOST_PORT=3002
ORDER_API_HOST_PORT=3000

# Optional advisory AI review. Ollama runs locally and is the default provider.
AI_JUDGE_PROVIDER=ollama
AI_JUDGE_MODEL=qwen3:4b-instruct
OLLAMA_BASE_URL=http://host.docker.internal:11434

# For hosted review, set AI_JUDGE_PROVIDER to openai or anthropic, select a
# compatible model, and uncomment only the matching API key in your local .env.
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
